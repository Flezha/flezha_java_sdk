<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.flezha</groupId>
        <artifactId>flezha-sdk-parent</artifactId>
        <version>0.1.0</version>
    </parent>

    <artifactId>flezha-sdk-protobuf</artifactId>
    <packaging>jar</packaging>
    <name>Flezha SDK Protobuf</name>
    <description>Java classes generated from flz_transport/../protobufs/*.proto.</description>

    <properties>
        <!-- Source-of-truth .proto location (relative to this module). -->
        <proto.source.dir>${project.basedir}/../../../protobufs</proto.source.dir>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
        </dependency>
    </dependencies>

    <build>
        <extensions>
            <extension>
                <groupId>kr.motd.maven</groupId>
                <artifactId>os-maven-plugin</artifactId>
                <version>${os.plugin.version}</version>
            </extension>
        </extensions>

        <plugins>
            <!-- Copy the canonical .proto files into the module's generated proto dir so
                 protoc sees them as the module's own. This way the .proto files are
                 never committed here; the workspace's flz_transport/../protobufs/*.proto
                 is the single source of truth. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-protos</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/proto-sources</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${proto.source.dir}</directory>
                                    <includes>
                                        <include>**/*.proto</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.xolstice.maven.plugins</groupId>
                <artifactId>protobuf-maven-plugin</artifactId>
                <configuration>
                    <protocArtifact>com.google.protobuf:protoc:${protobuf.version}:exe:${os.detected.classifier}</protocArtifact>
                    <protoSourceRoot>${project.build.directory}/proto-sources</protoSourceRoot>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Enforce that this module remains pure generated code: no hand-written
                 Java sources under src/main/java. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>no-handwritten-sources</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireFilesDontExist>
                                    <files>
                                        <file>${project.basedir}/src/main/java</file>
                                    </files>
                                    <message>flezha-sdk-protobuf must contain only generated code; remove src/main/java.</message>
                                </requireFilesDontExist>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
