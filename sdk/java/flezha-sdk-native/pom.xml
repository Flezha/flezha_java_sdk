<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.flezha</groupId>
        <artifactId>flezha-sdk-parent</artifactId>
        <version>0.1.0</version>
    </parent>

    <artifactId>flezha-sdk-native</artifactId>
    <packaging>jar</packaging>
    <name>Flezha SDK Native</name>
    <description>The FlzCore JNI binding + bundled per-OS flz_core_ffi native binaries.</description>

    <properties>
        <!-- Directory that contains the build-native.sh helper script. -->
        <build.native.script>${project.basedir}/../../../scripts/build-native.sh</build.native.script>
        <native.output.dir>${project.basedir}/src/main/resources/native</native.output.dir>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.flezha</groupId>
            <artifactId>flezha-sdk-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.google.code.findbugs</groupId>
            <artifactId>jsr305</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- JNI tests require the host-triple native binary to be staged. -->
                    <excludedGroups>jni,stress</excludedGroups>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>jni-tests</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <excludedGroups>stress</excludedGroups>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>stress-tests</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <excludedGroups>-</excludedGroups>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!--
          native-build: portable packaging. Stages all five triples — the host
          compiled from source, the other four downloaded from the release
          matching this version and checksum-verified — then asserts all five
          before shading. A triple already on disk is left alone, so a tree that
          was just cross-built locally is never overridden by a download. This is
          the only profile that touches the network, and no test path uses it.
        -->
        <profile>
            <id>native-build</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>stage-all-triples</id>
                                <phase>generate-resources</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>${build.native.script}</executable>
                                    <arguments>
                                        <argument>--output</argument>
                                        <argument>${native.output.dir}</argument>
                                        <argument>--targets</argument>
                                        <argument>all</argument>
                                        <argument>--skip-present</argument>
                                        <argument>--fetch-missing</argument>
                                        <argument>${project.version}</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-enforcer-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>require-native-binary</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>enforce</goal>
                                </goals>
                                <configuration>
                                    <rules>
                                        <requireFilesExist>
                                            <files>
                                                <file>${native.output.dir}/linux-x64/libflz_core_ffi.so</file>
                                                <file>${native.output.dir}/linux-arm64/libflz_core_ffi.so</file>
                                                <file>${native.output.dir}/macos-x64/libflz_core_ffi.dylib</file>
                                                <file>${native.output.dir}/macos-arm64/libflz_core_ffi.dylib</file>
                                                <file>${native.output.dir}/windows-x64/libflz_core_ffi.dll</file>
                                            </files>
                                            <message>native-build: a portable jar needs all five libflz_core_ffi binaries. Stage the missing ones with `scripts/build-native.sh --output sdk/java/flezha-sdk-native/src/main/resources/native --targets all`.</message>
                                        </requireFilesExist>
                                    </rules>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
          native-verify: assert the HOST triple's binary is staged, without
          building or downloading anything. Every test path uses this profile —
          `mvn verify`, the conformance suite, CI — because the suites run on
          the machine they run on and need no other platform's library. The
          other four triples are a distribution concern; see native-build.
        -->
        <profile>
            <id>native-verify</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-enforcer-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>require-host-native-binary</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>enforce</goal>
                                </goals>
                                <configuration>
                                    <rules>
                                        <requireProperty>
                                            <property>native.host.dir</property>
                                            <message>native-verify: this os.name/os.arch has no supported flz_core_ffi triple. Supported: linux-x64, linux-arm64, macos-x64, macos-arm64, windows-x64.</message>
                                        </requireProperty>
                                        <requireFilesExist>
                                            <files>
                                                <file>${native.output.dir}/${native.host.dir}/libflz_core_ffi.${native.host.ext}</file>
                                            </files>
                                            <message>native-verify: the host triple's binary is not staged at src/main/resources/native/${native.host.dir}/libflz_core_ffi.${native.host.ext}. It is build output, not tracked in git — produce it with `scripts/build-native.sh --output sdk/java/flezha-sdk-native/src/main/resources/native`.</message>
                                        </requireFilesExist>
                                    </rules>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
          The host triple's staged directory and library extension, resolved
          from os.name/os.arch exactly as NativeLibraryLoader resolves them at
          runtime. Kept in Maven rather than a script so `native-verify` needs
          no Rust toolchain: the CI job that runs the Java unit tests has none.
        -->
        <profile>
            <id>host-linux-x64</id>
            <activation><os><name>linux</name><arch>amd64</arch></os></activation>
            <properties>
                <native.host.dir>linux-x64</native.host.dir>
                <native.host.ext>so</native.host.ext>
            </properties>
        </profile>
        <profile>
            <id>host-linux-arm64</id>
            <activation><os><name>linux</name><arch>aarch64</arch></os></activation>
            <properties>
                <native.host.dir>linux-arm64</native.host.dir>
                <native.host.ext>so</native.host.ext>
            </properties>
        </profile>
        <profile>
            <id>host-macos-x64</id>
            <activation><os><family>mac</family><arch>x86_64</arch></os></activation>
            <properties>
                <native.host.dir>macos-x64</native.host.dir>
                <native.host.ext>dylib</native.host.ext>
            </properties>
        </profile>
        <profile>
            <id>host-macos-arm64</id>
            <activation><os><family>mac</family><arch>aarch64</arch></os></activation>
            <properties>
                <native.host.dir>macos-arm64</native.host.dir>
                <native.host.ext>dylib</native.host.ext>
            </properties>
        </profile>
        <profile>
            <id>host-windows-x64</id>
            <activation><os><family>windows</family><arch>amd64</arch></os></activation>
            <properties>
                <native.host.dir>windows-x64</native.host.dir>
                <native.host.ext>dll</native.host.ext>
            </properties>
        </profile>

    </profiles>
</project>
