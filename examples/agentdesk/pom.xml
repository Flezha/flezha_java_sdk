<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Standalone on purpose: no parent, and one dependency on a released
         coordinate, so this builds the way your own project would rather than
         the way a module inside the SDK's reactor does. Open this file in an
         IDE and it resolves. -->
    <groupId>com.flezha.examples</groupId>
    <artifactId>agentdesk</artifactId>
    <version>0.1.0</version>
    <packaging>jar</packaging>

    <name>Flezha agentdesk example</name>
    <description>The Part 3 chat sessions: the runner that serves the agent relay.</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>21</maven.compiler.release>
        <flezha.sdk.version>0.1.0</flezha.sdk.version>
    </properties>

    <dependencies>
        <!-- The aggregate jar: the authoring surface, the runtime and the
             native binaries for every supported platform, in one coordinate. -->
        <dependency>
            <groupId>com.flezha</groupId>
            <artifactId>flezha-sdk</artifactId>
            <version>${flezha.sdk.version}</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>agentdesk</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <!-- One runnable jar with the SDK inside: java -jar target/agentdesk.jar -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.flezha.examples.agentdesk.Main</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
