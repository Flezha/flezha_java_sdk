{
  "runtime": "java",
  "sdk_lang": 2,
  "command": {
    "test": "java -jar {artifact} {namespace}",
    "bench": "java -jar {artifact} {namespace}"
  },
  "artifacts": {
    "test": [
      "target/java_runner.jar",
      "dist/java_runner.jar"
    ],
    "bench": [
      "target/java_runner.jar",
      "dist/java_runner.jar"
    ]
  },
  "build": {
    "test": "scripts/build-native.sh --output sdk/java/flezha-sdk-native/src/main/resources/native && mvn -B -DskipTests -P native-verify -f sdk/java/pom.xml install && mvn -B -DskipTests -f test/apps/java_runner/pom.xml package",
    "bench": "scripts/build-native.sh --output sdk/java/flezha-sdk-native/src/main/resources/native && mvn -B -DskipTests -P native-verify -f sdk/java/pom.xml install && mvn -B -DskipTests -f test/apps/java_runner/pom.xml package"
  },
  "connect_timeout_ms": 60000,
  "transports": [
    "uds",
    "quic"
  ],
  "dispatch": {
    "model": "thread-pool",
    "detail": "A worker pool of platform threads over the shared poll core; per-cell exclusivity keeps one Cell on one worker at a time.",
    "env": {
      "FLEZHA_WORKER_POOL_SIZE": "worker threads (default: the host's core count)"
    }
  },
  "topology_surfaces": [
    "merge",
    "branch",
    "bounded",
    "shorthand",
    "shorthand_typed_output"
  ],
  "toolchain": "java -version",
  "deferred": [],
  "fixtures": {
    "runner_lifecycle": [
      "do_nothing",
      "compare_filter",
      "bench_echo"
    ],
    "connect_discovery": [
      "do_nothing"
