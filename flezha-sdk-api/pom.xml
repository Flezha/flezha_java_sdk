<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.flezha</groupId>
        <artifactId>flezha-sdk-parent</artifactId>
        <version>0.1.0</version>
    </parent>

    <artifactId>flezha-sdk-api</artifactId>
    <packaging>jar</packaging>
    <name>Flezha SDK API</name>
    <description>Public API surface — sealed types, handler interface, settings, transformers.</description>

    <dependencies>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.google.code.findbugs</groupId>
            <artifactId>jsr305</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
        </dependency>
    </dependencies>

    <properties>
        <!-- The contract set `flz_transport/errors.json` is read from: `contract/`
             beside the package in its own repository, the enclosing tree in the
             core's, or FLEZHA_CONTRACT_DIR, as the fixture tests resolve it. -->
        <flezha.contract.dir>${project.basedir}/../contract</flezha.contract.dir>
    </properties>

    <build>
        <!-- The error catalogue FlezhaException renders the SDK's own refusals from;
             FlezhaExceptionTest fails a build that did not package it. -->
        <resources>
            <resource>
                <directory>${flezha.contract.dir}/flz_transport</directory>
                <includes>
                    <include>errors.json</include>
                </includes>
                <targetPath>com/flezha/sdk</targetPath>
            </resource>
        </resources>
    </build>

    <profiles>
        <profile>
            <id>contract-in-core-tree</id>
            <activation>
                <file>
                    <exists>${basedir}/../../../test/fixtures/contract.txt</exists>
                </file>
            </activation>
            <properties>
                <flezha.contract.dir>${project.basedir}/../../..</flezha.contract.dir>
            </properties>
        </profile>
        <profile>
            <id>contract-from-env</id>
            <activation>
                <property>
                    <name>env.FLEZHA_CONTRACT_DIR</name>
                </property>
            </activation>
            <properties>
                <flezha.contract.dir>${env.FLEZHA_CONTRACT_DIR}</flezha.contract.dir>
            </properties>
        </profile>
    </profiles>
</project>
